---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import RobotHero from '../components/RobotHero.astro';
import { getCollection } from 'astro:content';
import { images } from '../data/portfolio-images';

// Ambil 3 project terbaru
const projects = (await getCollection('work'))
  .sort((a, b) => parseInt(b.data.year) - parseInt(a.data.year))
  .slice(0, 3);

const stats = [
  { value: 500, suffix: 'K+', decimals: 0, label: 'Household records validated' },
  { value: 36, suffix: '', decimals: 0, label: 'Provinces covered' },
  { value: 100, suffix: '%', decimals: 0, label: 'Functional tests passed' },
  { value: 3.57, suffix: '', decimals: 2, label: 'GPA out of 4.00' },
];

const stack = [
  'JavaScript', 'PHP', 'Dart', 'Python', 'Java', 'Laravel', 'Flutter',
  'MySQL', 'SQLite', 'MongoDB', 'Git', 'Google Apps Script',
];

const experience = [
  {
    year: '2025',
    role: 'Frontend Developer Intern',
    org: 'Diskominfotik Provinsi Bengkulu',
    text: 'Contributed to BEN-Connect, a government data integration portal. Collaborated with backend developers and stakeholders to gather requirements and refine frontend features.',
  },
  {
    year: '2024',
    role: 'Project Assistant',
    org: 'Impaclabs Indonesia',
    text: 'Supported the development of company profile and chatbot sales landing pages. Coordinated task progress and communication between technical and non-technical stakeholders.',
  },
  {
    year: '2023 – 2024',
    role: 'Data Processor & Data Entry',
    org: 'PT Artistik Studio',
    text: 'Processed and validated over 500,000 household records across 36 provinces for a national ESDM program.',
  },
];

const skillGroups = [
  { title: 'Languages & Frameworks', items: ['JavaScript', 'PHP', 'Dart', 'Python', 'Java', 'Laravel', 'Flutter', 'Bootstrap', 'Google Apps Script'] },
  { title: 'Databases & Tools', items: ['MySQL', 'SQLite', 'MongoDB', 'Git', 'Microsoft Office', 'Google Workspace'] },
  { title: 'Core Competencies', items: ['Web & Mobile Dev', 'Database Management', 'Data Processing', 'Project Coordination', 'UI/UX Testing'] },
];
---

<BaseLayout title="Muhamad Irfan — Software Developer">
  <span id="top" class="absolute top-0"></span>

  <!-- ==========================================
       HERO
       ========================================== -->
  <section class="container-content pt-32 pb-20 min-h-[100svh] flex flex-col justify-center relative">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-center">

      <div class="relative z-10">
        <p class="status-pill reveal mb-8">
          <span class="status-dot" aria-hidden="true"></span>
          Available for entry-level roles
        </p>

        <h1 class="text-hero text-[var(--color-fg)] mb-8" aria-label="Software Developer">
          <span class="hero-line" aria-hidden="true"><span style="--i:0">Software</span></span>
          <span class="hero-line" aria-hidden="true"><span style="--i:1" class="italic hero-gradient">Developer</span></span>
        </h1>

        <p class="text-lg md:text-xl text-[var(--color-muted)] leading-relaxed mb-10 max-w-lg reveal" style="--d:350ms">
          I build workflow-oriented systems, from government data portals to mobile school platforms with research-driven access control.
        </p>

        <div class="flex flex-wrap gap-4 reveal mb-12" style="--d:450ms">
          <a href="#work" class="btn-primary group">
            <span>View Work</span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#research" class="btn-ghost">Read Research</a>
        </div>

        <SocialLinks size="sm" class="reveal" />
      </div>

      <div class="relative h-[360px] sm:h-[440px] lg:h-[600px] reveal" style="--d:200ms">
        <div class="hero-visual w-full h-full">
          <RobotHero />
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <dl class="stats-strip reveal mt-16 lg:mt-20" style="--d:550ms">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat-label">{s.label}</dt>
          <dd class="stat-value">
            <span data-count={s.value} data-decimals={s.decimals}>{s.value}</span>{s.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ==========================================
       STACK MARQUEE
       ========================================== -->
  <div class="marquee reveal" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <ul class="marquee-group">
          {stack.map((s) => (
            <li class="marquee-item"><span class="marquee-dot"></span>{s}</li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <!-- ==========================================
       SELECTED WORK
       ========================================== -->
  <section id="work" data-section-id="work" class="container-content py-28 md:py-36">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6 reveal">
      <div>
        <p class="section-label mb-4">Selected Work</p>
        <h2 class="text-heading">Recent Projects</h2>
      </div>
      <a href="/work" class="link-underline font-mono text-sm text-[var(--color-accent)]">
        View all work <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {projects.map((project, i) => {
        const thumb = images.projectThumbnails[project.id] || images.projectThumbnails["malka-smartschool"];
        return (
          <a
            href={`/work/${project.id}`}
            class={`project-card reveal group block ${i === 0 ? 'md:col-span-2' : ''}`}
            style={`--d:${i * 100}ms`}
            data-spotlight
          >
            <div class="project-media relative overflow-hidden rounded-2xl glass-panel aspect-[16/10] md:aspect-[21/9] mb-6">
              <img
                src={thumb.url}
                alt={thumb.alt}
                class="project-img w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent opacity-80"></div>
              <span class="project-year">{project.data.year}</span>
              <span class="project-open" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </span>
            </div>

            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 px-1">
              <div>
                <h3 class="text-2xl md:text-3xl font-serif mb-2 transition-colors duration-300 group-hover:text-[var(--color-accent)]">{project.data.title}</h3>
                <p class="text-sm text-[var(--color-muted)] line-clamp-2 max-w-2xl">{project.data.desc[0]}</p>
              </div>
              <div class="flex flex-wrap gap-2 shrink-0">
                {project.data.tech.slice(0, 3).map((tech) => (
                  <span class="chip font-mono">{tech}</span>
                ))}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ==========================================
       TIMELINE
       ========================================== -->
  <section id="timeline" data-section-id="timeline" class="container-content py-28 md:py-36">
    <div class="mb-16 reveal">
      <p class="section-label mb-4">Career</p>
      <h2 class="text-heading">Experience</h2>
    </div>

    <ol class="timeline" id="timeline-list">
      <span class="timeline-rail" aria-hidden="true"><span class="timeline-fill" id="timeline-fill"></span></span>
      {experience.map((item, i) => (
        <li class="timeline-item reveal" style={`--d:${i * 60}ms`} data-timeline-item>
          <span class="timeline-dot" aria-hidden="true"></span>
          <span class="font-mono text-sm text-[var(--color-accent)] mb-2 block">{item.year}</span>
          <h3 class="text-xl md:text-2xl font-medium text-[var(--color-fg)] mb-1">{item.role}</h3>
          <p class="text-sm text-[var(--color-fg)]/70 mb-3">{item.org}</p>
          <p class="text-sm md:text-base text-[var(--color-muted)] max-w-2xl leading-relaxed">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ==========================================
       RESEARCH
       ========================================== -->
  <section id="research" data-section-id="research" class="container-content py-28 md:py-36">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-12 items-start">

      <div class="reveal">
        <p class="section-label mb-4">Research</p>
        <h2 class="text-heading mb-6">Published Work</h2>
        <a href="/research" class="btn-ghost">Read full paper <span aria-hidden="true">&rarr;</span></a>
      </div>

      <article class="reveal glass-panel research-card p-8 md:p-12" style="--d:120ms" data-spotlight>
        <p class="font-mono text-xs text-[var(--color-accent-2)] tracking-widest mb-4">Peer-reviewed publication, 2026</p>
        <h3 class="text-2xl md:text-3xl font-serif leading-tight mb-6">Human-in-the-Loop Request-Response Access Control for Mobile Smart School Information Systems</h3>
        <p class="text-[var(--color-muted)] leading-relaxed mb-8 max-w-prose">
          A TAM evaluation. Designed a Human-in-the-Loop mechanism that extends conventional RBAC to balance parental access with institutional governance in pesantren environments.
        </p>

        <div class="grid grid-cols-2 gap-6 border-t border-[var(--color-border)] pt-6">
          <div>
            <p class="font-mono text-xs text-[var(--color-muted)] mb-1">Functional testing</p>
            <p class="text-4xl md:text-5xl font-serif text-[var(--color-fg)]"><span data-count="100" data-decimals="0">100</span>%</p>
          </div>
          <div>
            <p class="font-mono text-xs text-[var(--color-muted)] mb-1">User acceptance (R²)</p>
            <p class="text-4xl md:text-5xl font-serif text-[var(--color-accent)]"><span data-count="0.734" data-decimals="3">0.734</span></p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ==========================================
       ABOUT & CAPABILITIES
       ========================================== -->
  <section id="about" data-section-id="about" class="container-content py-28 md:py-36">
    <div class="grid md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20 items-start">

      <div class="reveal md:sticky md:top-32">
        <p class="section-label mb-4">About</p>
        <h2 class="text-heading mb-6">The developer behind the code.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed mb-6">
          I am a Computer Science graduate from Universitas Pendidikan Indonesia (GPA: 3.57/4.00). My work focuses on building practical, workflow-oriented applications, from government data portals to mobile platforms.
        </p>
        <p class="text-[var(--color-muted)] leading-relaxed">
          Beyond code, I am interested in how authorization and human-in-the-loop systems can be designed to accommodate institutional governance without sacrificing usability.
        </p>
      </div>

      <div class="reveal" style="--d:120ms">
        <h3 class="font-mono text-sm tracking-widest text-[var(--color-muted)] mb-8 pb-2 border-b border-[var(--color-border)]">Capabilities &amp; Stack</h3>

        <div class="space-y-10">
          {skillGroups.map((group) => (
            <div>
              <h4 class="text-lg font-medium mb-4">{group.title}</h4>
              <div class="flex flex-wrap gap-2">
                {group.items.map((s) => (
                  <span class="skill-chip">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ==========================================
       CONTACT
       ========================================== -->
  <section id="contact" data-section-id="contact" class="container-content py-32 md:py-44 text-center relative">
    <div class="contact-aura" aria-hidden="true"></div>
    <p class="section-label justify-center mb-6 reveal">Contact</p>
    <h2 class="text-5xl md:text-7xl lg:text-8xl font-serif mb-8 reveal" style="--d:80ms">Let's build something.</h2>
    <p class="text-lg md:text-xl text-[var(--color-muted)] mb-12 max-w-2xl mx-auto reveal" style="--d:160ms">
      I am currently open to entry-level software development roles. Whether you have an opportunity or just want to connect, my inbox is always open.
    </p>

    <div class="reveal" style="--d:240ms">
      <a href="mailto:mhmdirfn01@gmail.com" class="btn-primary btn-lg magnetic mb-12" data-magnetic>
        <span>Send an Email</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <SocialLinks size="md" class="justify-center reveal" />
  </section>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    /* 1. Count-up angka saat terlihat */
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);
    const runCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.count || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      if (reduced) { el.textContent = target.toFixed(decimals); return; }
      const start = performance.now();
      const duration = 1800;
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        el.textContent = (target * easeOut(p)).toFixed(decimals);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const counterIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { runCounter(e.target as HTMLElement); counterIO.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => {
      if (!reduced) el.textContent = (0).toFixed(parseInt(el.dataset.decimals || '0', 10));
      counterIO.observe(el);
    });

    /* 2. Spotlight mengikuti kursor pada kartu */
    if (finePointer && !reduced) {
      document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      /* 3. Tombol magnetik */
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
        btn.addEventListener('pointermove', (e) => {
          const r = btn.getBoundingClientRect();
          const x = (e.clientX - (r.left + r.width / 2)) * 0.25;
          const y = (e.clientY - (r.top + r.height / 2)) * 0.35;
          btn.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        });
        btn.addEventListener('pointerleave', () => { btn.style.transform = ''; });
      });

      /* 4. Parallax halus pada visual hero */
      const visual = document.querySelector<HTMLElement>('.hero-visual');
      if (visual) {
        window.addEventListener('scroll', () => {
          const y = Math.min(window.scrollY, 800);
          visual.style.setProperty('--py', `${y * 0.12}px`);
        }, { passive: true });
      }
    }

    /* 5. Timeline: garis terisi mengikuti scroll */
    const list = document.getElementById('timeline-list');
    const fill = document.getElementById('timeline-fill');
    const items = document.querySelectorAll<HTMLElement>('[data-timeline-item]');
    if (list && fill) {
      let ticking = false;
      const update = () => {
        const rect = list.getBoundingClientRect();
        const vh = window.innerHeight;
        const line = vh * 0.6; // titik acuan di layar
        const progress = Math.min(Math.max((line - rect.top) / rect.height, 0), 1);
        fill.style.transform = `scaleY(${progress})`;
        items.forEach((item) => {
          item.classList.toggle('is-passed', item.getBoundingClientRect().top < line);
        });
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.45rem 1rem; border-radius: 9999px;
    font-size: 0.8rem; font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 50%, transparent);
    backdrop-filter: blur(10px);
  }
  .status-dot {
    width: 8px; height: 8px; border-radius: 9999px; background: #4ade80;
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6);
    animation: pulse-dot 2s infinite;
  }
  @keyframes pulse-dot {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55); }
    70% { box-shadow: 0 0 0 10px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  /* Satu momen utama: judul naik dari balik mask */
  .hero-line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-line > span {
    display: inline-block;
    transform: translate3d(0, 110%, 0) rotate(2deg);
    transform-origin: left bottom;
  }
  :global(body.content-loaded) .hero-line > span {
    animation: line-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 140ms + 100ms);
  }
  @keyframes line-rise { to { transform: translate3d(0, 0, 0) rotate(0); } }

  .hero-gradient {
    background: linear-gradient(100deg, var(--color-muted) 0%, var(--color-accent) 45%, var(--color-accent-2, #7c5cff) 70%, var(--color-muted) 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    animation: shimmer 8s ease-in-out infinite alternate;
    padding-right: 0.1em;
  }
  @keyframes shimmer { to { background-position: 100% 0; } }

  .hero-visual { transform: translate3d(0, var(--py, 0px), 0); will-change: transform; }

  /* ---------- Buttons ---------- */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    border-radius: 9999px; padding: 0.9rem 2rem; font-size: 0.9rem; font-weight: 500;
    background: var(--color-fg); color: var(--color-bg);
    transition: background-color 0.3s ease, box-shadow 0.4s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn-primary:hover { background: var(--color-accent); box-shadow: 0 0 32px rgba(139, 168, 255, 0.45); }
  .btn-primary:focus-visible, .btn-ghost:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .btn-lg { padding: 1.1rem 2.6rem; font-size: 1rem; }
  .btn-arrow { transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .btn-primary:hover .btn-arrow { transform: translateX(4px); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 9999px;
    border: 1px solid var(--color-border); padding: 0.9rem 2rem; font-size: 0.9rem; font-weight: 500;
    color: var(--color-fg); backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--color-surface) 30%, transparent);
    transition: border-color 0.3s ease, color 0.3s ease, background-color 0.3s ease;
  }
  .btn-ghost:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .link-underline { position: relative; padding-bottom: 4px; }
  .link-underline::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: currentColor; transform-origin: right; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .link-underline:hover::after { transform: scaleX(0.35); }

  /* ---------- Stats ---------- */
  .stats-strip {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    border: 1px solid var(--color-border); border-radius: 1.25rem; overflow: hidden;
    background: var(--color-border);
  }
  @media (min-width: 768px) { .stats-strip { grid-template-columns: repeat(4, 1fr); } }
  .stat {
    display: flex; flex-direction: column-reverse; gap: 0.35rem; padding: 1.4rem 1.5rem;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent); backdrop-filter: blur(12px);
  }
  .stat-label { font-size: 0.75rem; color: var(--color-muted); line-height: 1.4; }
  .stat-value { font-family: var(--font-serif, 'Instrument Serif', serif); font-size: clamp(1.9rem, 4vw, 2.75rem); line-height: 1; color: var(--color-fg); font-variant-numeric: tabular-nums; }

  /* ---------- Marquee ---------- */
  .marquee {
    border-block: 1px solid var(--color-border); overflow: hidden; padding: 1.1rem 0;
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-group { display: flex; gap: 2.5rem; padding-right: 2.5rem; }
  .marquee-item { display: inline-flex; align-items: center; gap: 0.75rem; white-space: nowrap; font-family: var(--font-mono, monospace); font-size: 0.85rem; color: var(--color-muted); }
  .marquee-dot { width: 5px; height: 5px; border-radius: 9999px; background: var(--color-accent); opacity: 0.7; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ---------- Project cards ---------- */
  .project-card { position: relative; outline: none; }
  .project-media { transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.5s ease; }
  .project-card:hover .project-media, .project-card:focus-visible .project-media {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -25px rgba(139, 168, 255, 0.35), 0 0 0 1px rgba(139, 168, 255, 0.25);
  }
  .project-card:focus-visible .project-media { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .project-img { opacity: 0.8; transform: scale(1.02); transition: opacity 0.6s ease, transform 1.1s cubic-bezier(0.22, 1, 0.36, 1); }
  .project-card:hover .project-img { opacity: 1; transform: scale(1.07); }
  .project-media::before {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 0.4s ease;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(139, 168, 255, 0.18), transparent 60%);
  }
  .project-card:hover .project-media::before { opacity: 1; }
  .project-year {
    position: absolute; top: 1rem; left: 1rem; z-index: 3; padding: 0.3rem 0.7rem; border-radius: 9999px;
    font-family: var(--font-mono, monospace); font-size: 0.7rem; color: var(--color-fg);
