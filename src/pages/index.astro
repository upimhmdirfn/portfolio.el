---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import RobotHero from '../components/RobotHero.astro';
import { getCollection } from 'astro:content';
import { images } from '../data/portfolio-images';
import { profile, experience } from '../data/profile';

const projects = (await getCollection('work'))
  .sort((a, b) => parseInt(b.data.year) - parseInt(a.data.year))
  .slice(0, 3);

const stats = [
  { value: 500, suffix: 'K+', decimals: 0, label: 'Household records validated' },
  { value: 36, suffix: '', decimals: 0, label: 'Provinces covered' },
  { value: 45, suffix: '', decimals: 0, label: 'Test scenarios, all passed' },
  { value: 0.734, suffix: '', decimals: 3, label: 'R² in user-acceptance study' },
];

const skillGroups = [
  { title: 'Languages & frameworks', items: ['JavaScript', 'PHP', 'Dart', 'Python', 'Java', 'Laravel', 'Flutter'] },
  { title: 'Data & tools', items: ['MySQL', 'SQLite', 'MongoDB', 'Git', 'Google Apps Script'] },
  { title: 'Practice', items: ['Web & mobile dev', 'Database design', 'Data processing', 'UI/UX testing'] },
];

const flow = ['Parent requests', 'RBAC check', 'Teacher approves', 'Data released'];
---

<BaseLayout title={`${profile.name} — ${profile.role}`}>
  <span id="top" class="absolute top-0"></span>

  <!-- ===== HERO ===== -->
  <section class="container-content pt-32 pb-20 min-h-[100svh] flex flex-col justify-center">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-center">

      <div class="relative z-10">
        <p class="status-pill reveal mb-8">
          <span class="status-dot" aria-hidden="true"></span>
          Available for entry-level roles
        </p>

        <h1 class="text-hero text-[var(--color-fg)] mb-8" aria-label={profile.role}>
          <span class="hero-line" aria-hidden="true"><span style="--i:0">Software</span></span>
          <span class="hero-line" aria-hidden="true"><span style="--i:1" class="italic hero-gradient">Developer</span></span>
        </h1>

        <p class="text-lg md:text-xl text-[var(--color-muted)] leading-relaxed mb-10 max-w-lg reveal" style="--d:300ms">
          {profile.statement}
        </p>

        <div class="flex flex-wrap gap-4 mb-12 reveal" style="--d:400ms">
          <a href="/work" class="btn-solid">View work <span aria-hidden="true">&rarr;</span></a>
          <a href="/playground" class="btn-line">Try the playground</a>
        </div>

        <SocialLinks size="sm" class="reveal" />
      </div>

      <div class="relative h-[360px] sm:h-[440px] lg:h-[600px] reveal" style="--d:200ms">
        <RobotHero />
      </div>
    </div>

    <dl class="stats-strip reveal mt-16 lg:mt-20" style="--d:450ms">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat-label">{s.label}</dt>
          <dd class="stat-value"><span data-count={s.value} data-decimals={s.decimals}>{s.value}</span>{s.suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ===== SELECTED WORK ===== -->
  <section id="work" class="container-content py-24 md:py-32">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 reveal">
      <div>
        <p class="section-label mb-4">Selected work</p>
        <h2 class="text-heading">Recent projects</h2>
      </div>
      <a href="/work" class="link-underline font-mono text-sm text-[var(--color-accent)]">View all work <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {projects.map((project, i) => {
        const thumb = images.projectThumbnails[project.id] || images.projectThumbnails["malka-smartschool"];
        const featured = i === 0;
        return (
          <a
            href={`/work/${project.id}`}
            class:list={['project-card spot glass-panel group reveal overflow-hidden', featured ? 'md:col-span-2 block md:grid md:grid-cols-[1.3fr_1fr]' : 'flex flex-col']}
            style={`--d:${i * 90}ms`}
            data-spotlight
          >
            <div class:list={['relative overflow-hidden bg-[var(--color-bg-sec)]', featured ? 'aspect-[16/10] md:aspect-auto md:min-h-[360px]' : 'aspect-[16/10]']}>
              <img src={thumb.url} alt={thumb.alt} class="project-img w-full h-full object-cover" loading={featured ? 'eager' : 'lazy'} decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)]/70 to-transparent"></div>
            </div>
            <div class="p-6 md:p-8 flex flex-col justify-between gap-6 relative z-10">
              <div>
                <p class="font-mono text-xs text-[var(--color-accent)] mb-3">{featured ? 'Featured · ' : ''}{project.data.year}</p>
                <h3 class:list={['font-serif mb-3 transition-colors duration-300 group-hover:text-[var(--color-accent)]', featured ? 'text-3xl md:text-4xl' : 'text-2xl']}>{project.data.title}</h3>
                <p class="text-sm md:text-base text-[var(--color-muted)] leading-relaxed line-clamp-3">{project.data.desc[0]}</p>
              </div>
              <div class="flex flex-wrap gap-2">
                {project.data.tech.slice(0, 4).map((t: string) => <span class="chip font-mono">{t}</span>)}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== PLAYGROUND TEASER ===== -->
  <section class="container-content pb-24 md:pb-32">
    <div class="teaser glass-panel p-8 md:p-14 grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-16 items-center reveal">
      <div>
        <p class="section-label mb-4">Playground</p>
        <h2 class="text-heading mb-5">Try the model, don't just read about it.</h2>
        <p class="text-[var(--color-muted)] leading-relaxed mb-8 max-w-md">
          An interactive version of the human-in-the-loop access control from my paper. Switch roles, request access, and watch each decision being evaluated.
        </p>
        <a href="/playground" class="btn-solid">Open the playground <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div>
        <p class="font-mono text-xs md:text-sm text-[var(--color-accent)] break-words mb-6">Access(u,o) = RBAC(u,o) ∧ Approval(r,u,o) = Approved</p>
        <ol class="flow-mini">
          {flow.map((f, i) => (
            <li><span class="flow-n">{String(i + 1).padStart(2, '0')}</span>{f}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== EXPERIENCE ===== -->
  <section class="container-content pb-24 md:pb-32">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6 reveal">
      <div>
        <p class="section-label mb-4">Experience</p>
        <h2 class="text-heading">Where I've worked</h2>
      </div>
      <a href="/about#chronology" class="link-underline font-mono text-sm text-[var(--color-accent)]">Full chronology <span aria-hidden="true">&rarr;</span></a>
    </div>

    <ol class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      {experience.map((job, i) => (
        <li class="exp-row reveal grid md:grid-cols-[210px_1fr] gap-2 md:gap-10 py-7" style={`--d:${i * 70}ms`}>
          <p class="font-mono text-sm text-[var(--color-accent)]">{job.period}</p>
          <div>
            <h3 class="text-xl font-medium text-[var(--color-fg)]">{job.role}</h3>
            <p class="text-sm text-[var(--color-fg)]/70 mt-1 mb-3">{job.org}</p>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed max-w-[62ch]">{job.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===== RESEARCH ===== -->
  <section class="container-content pb-24 md:pb-32">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-10 lg:gap-12 items-start">
      <div class="reveal">
        <p class="section-label mb-4">Research</p>
        <h2 class="text-heading mb-6">Published work</h2>
        <a href="/research" class="btn-line">Read the paper <span aria-hidden="true">&rarr;</span></a>
      </div>

      <article class="reveal glass-panel spot p-8 md:p-12" style="--d:100ms" data-spotlight>
        <p class="font-mono text-xs text-[var(--color-accent-2)] tracking-widest mb-4">Peer-reviewed publication, 2026</p>
        <h3 class="text-2xl md:text-3xl font-serif leading-tight mb-6">Human-in-the-Loop Request-Response Access Control for Mobile Smart School Information Systems</h3>
        <p class="text-[var(--color-muted)] leading-relaxed mb-8 max-w-prose">
          A TAM evaluation. A mechanism that extends conventional RBAC to balance parental access with institutional governance in pesantren environments.
        </p>
        <div class="grid grid-cols-2 gap-6 border-t border-[var(--color-border)] pt-6">
          <div>
            <p class="font-mono text-xs text-[var(--color-muted)] mb-1">Functional testing</p>
            <p class="text-4xl md:text-5xl font-serif">100%</p>
          </div>
          <div>
            <p class="font-mono text-xs text-[var(--color-muted)] mb-1">User acceptance (R²)</p>
            <p class="text-4xl md:text-5xl font-serif text-[var(--color-accent)]">0.734</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ===== STACK ===== -->
  <section class="container-content pb-24 md:pb-32">
    <p class="section-label mb-8 reveal">Stack</p>
    <div class="grid md:grid-cols-3 gap-10 reveal" style="--d:80ms">
      {skillGroups.map((g) => (
        <div>
          <h3 class="text-lg font-medium mb-4">{g.title}</h3>
          <div class="flex flex-wrap gap-2">
            {g.items.map((s) => <span class="skill-chip">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="container-content py-24 md:py-32 text-center border-t border-[var(--color-border)]">
    <h2 class="text-5xl md:text-7xl font-serif mb-8 reveal">Let's talk.</h2>
    <p class="text-lg md:text-xl text-[var(--color-muted)] mb-10 max-w-xl mx-auto reveal" style="--d:100ms">
      I'm open to entry-level software development roles. If you're hiring, or have a workflow problem worth solving, I'd like to hear about it.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mb-12 reveal" style="--d:180ms">
      <a href={`mailto:${profile.email}`} class="btn-solid">Send an email <span aria-hidden="true">&rarr;</span></a>
      <a href="/contact" class="btn-line">Other ways to reach me</a>
    </div>
    <SocialLinks size="md" class="justify-center reveal" />
  </section>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = (t: number) => 1 - Math.pow(1 - t, 4);
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        const target = parseFloat(el.dataset.count || '0');
        const d = parseInt(el.dataset.decimals || '0', 10);
        if (reduced) { el.textContent = target.toFixed(d); return; }
        const t0 = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - t0) / 1600, 1);
          el.textContent = (target * ease(p)).toFixed(d);
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => {
      if (!reduced) el.textContent = (0).toFixed(parseInt(el.dataset.decimals || '0', 10));
      io.observe(el);
    });
  </script>
</BaseLayout>

<style>
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 1rem; border-radius: 9999px;
    font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-muted);
    border: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-surface) 50%, transparent);
  }
  .status-dot { width: 8px; height: 8px; border-radius: 9999px; background: #4ade80; animation: pulse-dot 2s infinite; }
  @keyframes pulse-dot {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55); }
    70% { box-shadow: 0 0 0 10px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  /* Satu momen utama: judul naik dari balik mask */
  .hero-line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-line > span { display: inline-block; transform: translate3d(0, 110%, 0) rotate(2deg); transform-origin: left bottom; }
  :global(body.content-loaded) .hero-line > span { animation: line-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards; animation-delay: calc(var(--i) * 140ms + 100ms); }
  @keyframes line-rise { to { transform: none; } }
  .hero-gradient {
    background: linear-gradient(100deg, var(--color-muted) 0%, var(--color-accent) 50%, var(--color-accent-2) 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; padding-right: 0.1em;
  }

  .stats-strip {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; overflow: hidden;
    border: 1px solid var(--color-border); border-radius: 1.25rem; background: var(--color-border);
  }
  @media (min-width: 768px) { .stats-strip { grid-template-columns: repeat(4, 1fr); } }
  .stat { display: flex; flex-direction: column-reverse; gap: 0.35rem; padding: 1.4rem 1.5rem; background: color-mix(in srgb, var(--color-bg) 88%, transparent); }
  .stat-label { font-size: 0.75rem; color: var(--color-muted); line-height: 1.4; }
  .stat-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.75rem); line-height: 1; font-variant-numeric: tabular-nums; }

  .link-underline { position: relative; padding-bottom: 4px; }
  .link-underline::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px; background: currentColor; transform-origin: right; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .link-underline:hover::after { transform: scaleX(0.35); }

  .project-card { transition: transform 0.5s var(--ease-out-expo), border-color 0.4s, box-shadow 0.5s; }
  .project-card:hover, .project-card:focus-visible { transform: translateY(-5px); border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border)); box-shadow: 0 30px 60px -28px rgba(139, 168, 255, 0.35); }
  .project-img { opacity: 0.85; transform: scale(1.02); transition: opacity 0.6s, transform 1.1s var(--ease-out-expo); }
  .project-card:hover .project-img { opacity: 1; transform: scale(1.06); }
  .chip { font-size: 0.65rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-border); }

  .flow-mini { list-style: none; display: grid; gap: 0.6rem; margin: 0; padding: 0; }
  .flow-mini li { display: flex; align-items: center; gap: 0.9rem; padding: 0.8rem 1rem; border: 1px solid var(--color-border); border-radius: 0.75rem; font-size: 0.9rem; background: color-mix(in srgb, var(--color-bg) 50%, transparent); }
  .flow-n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-accent); border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent); border-radius: 9999px; padding: 0.15rem 0.5rem; }

  .skill-chip { font-size: 0.875rem; padding: 0.45rem 0.9rem; border-radius: 0.6rem; background: var(--color-surface); border: 1px solid var(--color-border); transition: border-color 0.3s, color 0.3s; }
  .skill-chip:hover { border-color: var(--color-accent); color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .hero-line > span { transform: none; animation: none !important; }
    .status-dot { animation: none; }
    .project-card, .project-img { transition: none; }
  }
</style>