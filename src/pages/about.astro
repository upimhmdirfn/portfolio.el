---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { images } from '../data/portfolio-images';
import { profile, experience, education, certifications, timelineData } from '../data/profile';

const facts = [
  { label: 'Education', value: education.school },
  { label: 'Based in', value: profile.location },
  { label: 'Focus', value: 'Web & mobile development, data processing' },
  { label: 'Status', value: 'Open to entry-level roles' },
];
---

<BaseLayout title={`About — ${profile.name}`} description="Computer Science graduate building practical, workflow-oriented applications.">
  <PageHeader
    label="About"
    title="Software that fits the way people actually work."
    intro="Computer Science graduate who builds practical, workflow-oriented applications, from government data portals to mobile platforms."
  />

  <!-- Intro + portrait -->
  <section class="container-content pb-24 md:pb-32">
    <div class="grid md:grid-cols-[0.8fr_1.4fr] gap-12 md:gap-20 items-start">

      <figure class="portrait reveal md:sticky md:top-28" data-spotlight>
        <div class="glass-panel spot p-2">
          <div class="aspect-[3/4] rounded-lg overflow-hidden bg-[var(--color-bg-sec)] relative">
            <img
              src={images.aboutPortrait.url}
              alt={images.aboutPortrait.alt}
              class="portrait-img w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent"></div>
            <figcaption class="absolute bottom-3 left-3 right-3 flex items-center justify-between font-mono text-[11px] text-[var(--color-fg)]/80">
              <span>{profile.name}</span>
              <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#4ade80]"></span>Open to work</span>
            </figcaption>
          </div>
        </div>
      </figure>

      <div class="reveal" style="--d:120ms">
        <div class="max-w-[62ch] text-lg text-[var(--color-muted)] leading-relaxed space-y-6">
          <p>
            I graduated in Computer Science from Universitas Pendidikan Indonesia (GPA 3.57/4.00). My work focuses on practical, workflow-oriented applications, where the hard part is rarely the code and usually the process around it.
          </p>
          <p>
            I have hands-on experience in web and mobile development, data processing (validating over 500,000 records for a national program), and coordinating between technical and non-technical stakeholders.
          </p>
          <p>
            I'm especially interested in authorization and human-in-the-loop systems: how access can follow institutional governance without sacrificing usability. That question became my published research, and you can
            <a href="/playground" class="text-[var(--color-accent)] underline underline-offset-4">try the model yourself</a>.
          </p>
        </div>

        <dl class="mt-12 grid sm:grid-cols-2 gap-px rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-border)]">
          {facts.map((f) => (
            <div class="bg-[var(--color-bg)]/85 p-5">
              <dt class="font-mono text-xs text-[var(--color-muted)] mb-1">{f.label}</dt>
              <dd class="text-[var(--color-fg)]">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="container-content pb-24 md:pb-32">
    <h2 class="text-3xl md:text-4xl font-serif mb-10 pb-4 border-b border-[var(--color-border)] reveal">Work experience</h2>
    <ol class="divide-y divide-[var(--color-border)]">
      {experience.map((job, i) => (
        <li class="reveal group grid md:grid-cols-[220px_1fr] gap-3 md:gap-10 py-8" style={`--d:${i * 70}ms`}>
          <p class="font-mono text-sm text-[var(--color-accent)] md:pt-1">{job.period}</p>
          <div>
            <h3 class="text-2xl font-medium text-[var(--color-fg)] transition-colors group-hover:text-[var(--color-accent)]">{job.role}</h3>
            <p class="text-[var(--color-fg)]/70 mt-1 mb-4">{job.org} <span class="text-[var(--color-muted)]">· {job.place}</span></p>
            <p class="text-[var(--color-muted)] leading-relaxed max-w-[62ch]">{job.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Education + certifications -->
  <section class="container-content pb-24 md:pb-32">
    <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16">
      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-serif mb-10 pb-4 border-b border-[var(--color-border)]">Education</h2>
        <div class="glass-panel spot p-8" data-spotlight>
          <h3 class="text-xl font-medium text-[var(--color-fg)] mb-1">{education.school}</h3>
          <p class="text-sm font-mono text-[var(--color-accent)] mb-4">{education.period} · GPA {education.gpa}</p>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">{education.degree}</p>
          <div class="border-t border-[var(--color-border)] pt-4 mt-6">
            <p class="text-xs font-mono text-[var(--color-muted)] mb-2">Thesis</p>
            <p class="text-sm text-[var(--color-fg)] leading-relaxed">{education.thesis}</p>
          </div>
        </div>
      </div>

      <div class="reveal" style="--d:100ms">
        <h2 class="text-3xl md:text-4xl font-serif mb-10 pb-4 border-b border-[var(--color-border)]">Certifications</h2>
        <ul class="space-y-5">
          {certifications.map((c) => (
            <li>
              <p class="text-[var(--color-fg)]">{c.title}</p>
              <p class="text-sm text-[var(--color-muted)] mt-1">{c.issuer} · {c.date}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Chronology (menggantikan halaman /timeline) -->
  <section id="chronology" class="container-content pb-16">
    <h2 class="text-3xl md:text-4xl font-serif mb-10 pb-4 border-b border-[var(--color-border)] reveal">Chronology</h2>
    <div class="space-y-12">
      {timelineData.map((group) => (
        <div class="grid md:grid-cols-[110px_1fr] gap-4 md:gap-10 reveal">
          <h3 class="font-serif italic text-4xl md:text-5xl text-[var(--color-fg)]/25 leading-none">{group.year}</h3>
          <ul class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
            {group.items.map((item) => (
              <li class="flex flex-col md:flex-row md:items-center justify-between gap-2 py-4" data-type={item.type}>
                <div>
                  <p class="text-[var(--color-fg)]">{item.title}</p>
                  <p class="text-sm text-[var(--color-muted)]">{item.subtitle}</p>
                </div>
                <span class="t-badge font-mono text-[11px] px-2.5 py-1 rounded-full self-start md:self-auto shrink-0">{item.type}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container-content pt-20 pb-8 text-center reveal">
    <p class="text-2xl md:text-3xl font-serif mb-6">Want to work together?</p>
    <a href="/contact" class="btn-solid">Get in touch <span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>

<style>
  .portrait-img { filter: grayscale(1) contrast(1.05); opacity: 0.85; transform: scale(1.03); transition: filter 0.9s var(--ease-out-expo), opacity 0.9s var(--ease-out-expo), transform 1.2s var(--ease-out-expo); }
  .portrait:hover .portrait-img { filter: grayscale(0); opacity: 1; transform: scale(1.06); }

  li { --tc: var(--color-accent); }
  li[data-type='Experience'] { --tc: #4ade80; }
  li[data-type='Education'] { --tc: #b79cff; }
  li[data-type='Certification'] { --tc: #fbbf24; }
  li[data-type='Organization'] { --tc: #f472b6; }
  .t-badge { color: var(--tc); border: 1px solid color-mix(in srgb, var(--tc) 35%, transparent); background: color-mix(in srgb, var(--tc) 10%, transparent); }

  @media (prefers-reduced-motion: reduce) { .portrait-img { transition: none; transform: none; } }
</style>