---
// src/layouts/BaseLayout.astro
import '@fontsource/instrument-serif';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import PortfolioLoader from '../components/loader/PortfolioLoader.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  image?: string; // path di /public, ukuran ideal 1200x630
  noindex?: boolean;
}

const { title, description = profile.description, image = '/og.png', noindex = false } = Astro.props;

const path = Astro.url.pathname;
const base = Astro.site ?? Astro.url;
const canonical = new URL(path, base).href;
const ogImage = new URL(image, base).href;

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/playground', label: 'Playground' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const footerLinks = [
  { label: 'GitHub', href: profile.links.github },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'Resume', href: profile.links.cv },
].filter((l) => l.href);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.description,
  url: new URL('/', base).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Bandung', addressCountry: 'ID' },
  alumniOf: 'Universitas Pendidikan Indonesia',
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en" class="bg-obsidian">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08090C" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const hasLoaded = sessionStorage.getItem('irfan_loaded');
        if (!hasLoaded && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('is-loading');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="text-[var(--color-fg)] flex flex-col min-h-screen relative overflow-x-clip">

    <div class="fixed top-0 left-0 w-full h-[2px] z-[100] pointer-events-none" aria-hidden="true">
      <div id="scroll-progress" class="scroll-progress"></div>
    </div>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] bg-[var(--color-fg)] text-[var(--color-bg)] px-4 py-2 rounded font-medium">
      Skip to content
    </a>

    <PortfolioLoader />

    <header id="site-header" class="site-header fixed top-4 left-1/2 w-[calc(100%-2rem)] max-w-5xl z-50">
      <nav class="glass-panel nav-shell flex items-center justify-between gap-4 px-5 md:px-6 py-3 rounded-full" aria-label="Main Navigation">
        <a href="/" class="font-serif text-xl italic tracking-wide text-[var(--color-fg)] hover:text-[var(--color-accent)] transition-colors shrink-0">
          Irfan<span class="text-[var(--color-accent)]">.</span>
        </a>
        <ul class="flex items-center gap-1 text-xs md:text-sm font-medium overflow-x-auto no-scrollbar">
          {nav.map((item) => (
            <li>
              <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        {profile.links.cv && (
          <a href={profile.links.cv} class="nav-cv hidden md:inline-flex" download>Resume</a>
        )}
      </nav>
    </header>

    <main id="main-content" class="flex-grow page-content relative z-10" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)] mt-24 relative z-10">
      <div class="container-content flex flex-col gap-4 py-8 text-xs font-mono text-[var(--color-muted)] md:flex-row md:items-center md:justify-between tracking-wider">
        <p>© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
        <ul class="flex flex-wrap gap-5">
          {footerLinks.map((l) => (
            <li><a href={l.href} class="hover:text-[var(--color-accent)] transition-colors" target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
          <li><a href={`mailto:${profile.email}`} class="hover:text-[var(--color-accent)] transition-colors">Email</a></li>
        </ul>
        <a href="#top" id="back-to-top" class="inline-flex items-center gap-2 hover:text-[var(--color-accent)] transition-colors">
          Back to top <span aria-hidden="true">&uarr;</span>
        </a>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let hasLoaded = false;
      try { hasLoaded = !!sessionStorage.getItem('irfan_loaded'); } catch (e) {}

      /* 1. Reveal (dimulai setelah loader selesai) */
      const startReveal = () => {
        const els = document.querySelectorAll('.reveal, .reveal-up, .reveal-clip, .stagger-container');
        if (reduced || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      };

      const showContent = () => {
        document.documentElement.classList.remove('is-loading');
        document.body.classList.add('content-loaded');
        startReveal();
      };

      if (hasLoaded || reduced) showContent();
      else window.addEventListener('loaderComplete', showContent, { once: true });

      /* 2. Progress bar + header hide/show (rAF throttled) */
      const progressBar = document.getElementById('scroll-progress');
      const header = document.getElementById('site-header');
      let lastY = window.scrollY;
      let ticking = false;

      const onScroll = () => {
        const y = window.scrollY;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (progressBar && max > 0) progressBar.style.transform = `scaleX(${Math.min(y / max, 1)})`;

        if (header) {
          header.classList.toggle('is-scrolled', y > 24);
          const down = y > lastY + 4;
          const up = y < lastY - 4;
          if (down && y > 240) header.classList.add('is-hidden');
          else if (up || y < 240) header.classList.remove('is-hidden');
        }
        lastY = y;
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
      }, { passive: true });
      onScroll();

      /* 3. Back to top */
      document.getElementById('back-to-top')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      });

      /* 4. Spotlight generik untuk semua [data-spotlight] */
      if (!reduced && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('pointermove', (e) => {
          const el = (e.target as Element | null)?.closest?.('[data-spotlight]') as HTMLElement | null;
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  html { scroll-padding-top: 6rem; }

  .scroll-progress {
    height: 100%; width: 100%; transform: scaleX(0); transform-origin: left;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
  }

  .site-header {
    transform: translate(-50%, 0);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .site-header.is-hidden { transform: translate(-50%, -140%); }
  .nav-shell { transition: padding 0.4s ease, box-shadow 0.4s ease; }
  .site-header.is-scrolled .nav-shell {
    padding-top: 0.6rem; padding-bottom: 0.6rem;
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
  }

  .nav-link {
    position: relative; display: block; padding: 0.4rem 0.75rem; border-radius: 9999px; white-space: nowrap;
    color: var(--color-muted); transition: color 0.3s ease, background-color 0.3s ease;
  }
  .nav-link:hover { color: var(--color-fg); }
  .nav-link.is-active { color: var(--color-fg); background: rgba(139, 168, 255, 0.14); }
  .nav-cv {
    align-items: center; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 500;
    color: var(--color-bg); background: var(--color-fg); transition: background-color 0.3s;
  }
  .nav-cv:hover { background: var(--color-accent); }
</style>