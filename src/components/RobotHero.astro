---
// src/components/RobotHero.astro
// Letakkan foto di public/images/irfan-face.jpg (atau ubah prop facePath).
interface Props {
  facePath?: string;
  name?: string;
  role?: string;
}
const {
  facePath = "/images/irfan-face.jpg",
  name = "Muhamad Irfan",
  role = "Software Developer",
} = Astro.props;
---

<robot-hero class="hero-scene" data-state="loading" data-mode="0">
  <div class="cyber-glow"></div>

  <!-- Lapisan wajah: samar sejak awal, terungkap di sekitar kursor -->
  <div class="face-layer" aria-hidden="true">
    <img
      class="face-img"
      src={facePath}
      alt=""
      decoding="async"
      onerror="this.closest('robot-hero')?.setAttribute('data-face','missing')"
    />
    <div class="face-tint"></div>
    <div class="face-shade"></div>
    <span class="face-mono">MI</span>
  </div>

  <div class="cyber-rings" aria-hidden="true">
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
  </div>

  <div
    class="robot-stage"
    role="img"
    aria-label={`Animated robot whose eyes follow the cursor, revealing a portrait of ${name}.`}
  >
    <div class="webgl-skeleton" aria-hidden="true">
      <div class="skeleton-spinner"></div>
      <span class="skeleton-text">Booting robot <b data-progress>0%</b></span>
    </div>
    <canvas class="webgl-canvas"></canvas>
  </div>

  <!-- HUD -->
  <div class="hud" aria-hidden="true">
    <span class="hud-corner hud-tl"></span>
    <span class="hud-corner hud-tr"></span>
    <span class="hud-corner hud-bl"></span>
    <span class="hud-corner hud-br"></span>
    <p class="hud-status"><span class="hud-led"></span><span data-status>Standby</span></p>
    <p class="hud-id"><b>{name}</b><span>{role}</span></p>
    <p class="hud-hint" data-hint>Hover to scan</p>
  </div>

  <div class="webgl-fallback">
    <div class="glass-panel p-6 max-w-xs text-center relative z-10">
      <p class="text-[var(--color-fg)] font-serif text-xl mb-1">{name}</p>
      <p class="text-[var(--color-muted)] font-mono text-sm">{role}</p>
    </div>
  </div>
</robot-hero>

<style>
  robot-hero { display: block; }

  .hero-scene {
    position: relative; width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; border-radius: 2rem; isolation: isolate;
  }

  /* ---------- Ambient ---------- */
  .cyber-glow {
    position: absolute; top: 50%; left: 50%; width: 80%; height: 80%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(139, 168, 255, 0.16) 0%, transparent 60%);
    filter: blur(60px); z-index: 0;
    animation: pulse-glow 6s infinite alternate ease-in-out;
  }
  @keyframes pulse-glow {
    0%   { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 1;   transform: translate(-50%, -50%) scale(1.08); }
  }
  .cyber-rings { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 2; pointer-events: none; }
  .ring { position: absolute; border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 50%; }
  .ring-1 { width: 118%; height: 118%; border-top-color: rgba(139, 168, 255, 0.3); animation: spin 30s linear infinite; }
  .ring-2 { width: 88%; height: 88%; border-left-color: rgba(183, 156, 255, 0.28); animation: spin-reverse 25s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spin-reverse { to { transform: rotate(-360deg); } }
  @media (max-width: 1024px) { .ring-1 { display: none; } }

  /* ---------- Face layer ---------- */
  .face-layer {
    --fx: 50%; --fy: 38%; --fr: 220px; --a: 0.1; --base: 0.1; --px: 0px; --py: 0px;
    position: absolute; inset: 0; z-index: 1; overflow: hidden; border-radius: inherit;
    pointer-events: none; isolation: isolate;
    -webkit-mask-image: radial-gradient(circle var(--fr) at var(--fx) var(--fy),
      rgba(0, 0, 0, var(--a)) 0%,
      rgba(0, 0, 0, calc(var(--a) * 0.55 + var(--base) * 0.45)) 45%,
      rgba(0, 0, 0, var(--base)) 100%);
    mask-image: radial-gradient(circle var(--fr) at var(--fx) var(--fy),
      rgba(0, 0, 0, var(--a)) 0%,
      rgba(0, 0, 0, calc(var(--a) * 0.55 + var(--base) * 0.45)) 45%,
      rgba(0, 0, 0, var(--base)) 100%);
  }
  .face-img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
    transform: translate3d(var(--px), var(--py), 0) scale(1.1);
    will-change: transform;
  }
  /* Duotone biru agar menyatu dengan palet Obsidian */
  .face-tint { position: absolute; inset: 0; mix-blend-mode: color; background: linear-gradient(160deg, #7b97ff, #2b3a8f 75%); opacity: 0.95; }
  .face-shade { position: absolute; inset: 0; background:
    radial-gradient(ellipse at 50% 40%, transparent 35%, var(--color-bg) 100%),
    linear-gradient(to top, var(--color-bg) 0%, transparent 45%); }
  .face-mono {
    display: none; position: absolute; inset: 0; place-items: center;
    font-family: var(--font-serif); font-style: italic; font-size: clamp(8rem, 22vw, 15rem);
    color: rgba(139, 168, 255, 0.55);
  }
  robot-hero[data-face='missing'] .face-img,
  robot-hero[data-face='missing'] .face-tint { display: none; }
  robot-hero[data-face='missing'] .face-mono { display: grid; }

  /* ---------- Canvas ---------- */
  .robot-stage { position: relative; width: 100%; height: 100%; z-index: 3; border-radius: inherit; }
  .webgl-canvas {
    display: block; width: 100%; height: 100%; outline: none; opacity: 0; transform: scale(0.97);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1), transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
  }
  robot-hero[data-state='ready'] .webgl-canvas { opacity: 1; transform: none; }

  .webgl-skeleton {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
    transition: opacity 0.6s ease, visibility 0.6s;
  }
  robot-hero:not([data-state='loading']) .webgl-skeleton { opacity: 0; visibility: hidden; }
  .skeleton-spinner { width: 3.5rem; height: 3.5rem; border-radius: 9999px; border: 2px solid rgba(139, 168, 255, 0.2); border-top-color: var(--color-accent); animation: spin 1s linear infinite; }
  .skeleton-text { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; color: var(--color-muted); }
  .skeleton-text b { font-weight: 500; color: var(--color-accent); margin-left: 0.4rem; }

  /* ---------- HUD ---------- */
  .hud { position: absolute; inset: 0; z-index: 4; pointer-events: none; opacity: 0; transition: opacity 1s ease 0.5s; font-family: var(--font-mono); }
  robot-hero:not([data-state='loading']) .hud { opacity: 1; }
  .hud-corner { position: absolute; width: 18px; height: 18px; border: 1px solid rgba(139, 168, 255, 0.45); }
  .hud-tl { top: 1rem; left: 1rem; border-right: 0; border-bottom: 0; border-top-left-radius: 6px; }
  .hud-tr { top: 1rem; right: 1rem; border-left: 0; border-bottom: 0; border-top-right-radius: 6px; }
  .hud-bl { bottom: 1rem; left: 1rem; border-right: 0; border-top: 0; border-bottom-left-radius: 6px; }
  .hud-br { bottom: 1rem; right: 1rem; border-left: 0; border-top: 0; border-bottom-right-radius: 6px; }

  .hud-status { position: absolute; top: 1.15rem; left: 2.4rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--color-muted); }
  .hud-led { width: 6px; height: 6px; border-radius: 9999px; background: var(--color-muted); transition: background-color 0.4s, box-shadow 0.4s; }
  robot-hero[data-mode='1'] .hud-led { background: var(--color-accent); box-shadow: 0 0 10px var(--color-accent); animation: blink 0.8s infinite; }
  robot-hero[data-mode='2'] .hud-led { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
  @keyframes blink { 50% { opacity: 0.3; } }

  .hud-id {
    position: absolute; left: 2.4rem; bottom: 1.1rem; display: flex; flex-direction: column; gap: 0.15rem;
    opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hud-id b { font-family: var(--font-serif); font-weight: 400; font-size: 1.25rem; color: var(--color-fg); letter-spacing: -0.01em; }
  .hud-id span { font-size: 0.65rem; letter-spacing: 0.1em; color: var(--color-accent); }
  robot-hero[data-mode='2'] .hud-id { opacity: 1; transform: none; }

  .hud-hint { position: absolute; right: 2.4rem; bottom: 1.15rem; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--color-muted); transition: opacity 0.6s; }
  robot-hero[data-mode='2'] .hud-hint, robot-hero[data-mode='1'] .hud-hint { opacity: 0; }

  /* ---------- Fallback (tanpa WebGL): wajah tampil statis ---------- */
  .webgl-fallback { position: absolute; inset: 0; z-index: 5; display: none; align-items: flex-end; justify-content: center; padding: 1.5rem; }
  robot-hero[data-state='fallback'] .webgl-fallback { display: flex; }
  robot-hero[data-state='fallback'] .robot-stage { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .cyber-glow, .ring, .skeleton-spinner, .hud-led { animation: none !important; }
    .webgl-canvas { transition: none; }
  }
</style>

<script>
  type Three = typeof import('three');

  const TAU = Math.PI * 2;
  const clamp = (v: number, a: number, b: number) => Math.min(Math.max(v, a), b);
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
  const easeOutBack = (t: number) => {
    const c1 = 1.70158, c3 = c1 + 1;
    return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
  };

  const hasWebGL = () => {
    try {
      const c = document.createElement('canvas');
      const gl = (c.getContext('webgl2') || c.getContext('webgl')) as WebGLRenderingContext | null;
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!gl;
    } catch {
      return false;
    }
  };

  class RobotHero extends HTMLElement {
    private cleanup?: () => void;
    private lazy?: IntersectionObserver;
    private booted = false;

    connectedCallback() {
      if (this.booted) return;
      this.lazy = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          this.lazy?.disconnect();
          this.booted = true;
          void this.boot();
        },
        { rootMargin: '200px' }
      );
      this.lazy.observe(this);
    }

    disconnectedCallback() {
      this.lazy?.disconnect();
      this.cleanup?.();
      this.cleanup = undefined;
      this.booted = false;
    }

    private async boot() {
      const stageEl = this.querySelector<HTMLElement>('.robot-stage')!;
      const canvas = this.querySelector<HTMLCanvasElement>('.webgl-canvas')!;
      const face = this.querySelector<HTMLElement>('.face-layer')!;
      const progressEl = this.querySelector<HTMLElement>('[data-progress]')!;
      const statusEl = this.querySelector<HTMLElement>('[data-status]')!;
      const hintEl = this.querySelector<HTMLElement>('[data-hint]')!;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = window.matchMedia('(pointer: coarse)').matches;
      if (coarse) hintEl.textContent = 'Tap to scan';

      const setFace = (fx: number, fy: number, fr: number, a: number, base: number, px = 0, py = 0) => {
        face.style.setProperty('--fx', `${fx}px`);
        face.style.setProperty('--fy', `${fy}px`);
        face.style.setProperty('--fr', `${fr}px`);
        face.style.setProperty('--a', a.toFixed(3));
        face.style.setProperty('--base', base.toFixed(3));
        face.style.setProperty('--px', `${px.toFixed(1)}px`);
        face.style.setProperty('--py', `${py.toFixed(1)}px`);
      };

      // Tampilan statis: dipakai saat reduced motion atau tanpa WebGL
      const staticFace = () => {
        const w = this.clientWidth || 400, h = this.clientHeight || 400;
        setFace(w / 2, h * 0.4, Math.min(w, h) * 0.5, 0.75, 0.35);
        this.dataset.mode = '2';
      };
      const fail = () => { this.dataset.state = 'fallback'; staticFace(); };

      if (!hasWebGL()) return fail();

      const mods = await Promise.all([
        import('three'),
        import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
        import('three/examples/jsm/environments/RoomEnvironment.js'),
      ]).catch(() => null);
      if (!mods) return fail();
      if (!this.isConnected) return;

      const [THREE, { RoundedBoxGeometry }, { RoomEnvironment }] = mods as [
        Three,
        typeof import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
        typeof import('three/examples/jsm/environments/RoomEnvironment.js'),
      ];

      /* ---------- Renderer & kamera ---------- */
      let renderer: InstanceType<Three['WebGLRenderer']>;
      try {
        renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: !coarse, powerPreference: 'high-performance' });
      } catch {
        return fail();
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, coarse ? 1.5 : 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;

      let W = stageEl.clientWidth || 1, H = stageEl.clientHeight || 1;
      renderer.setSize(W, H, false);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, W / H, 0.1, 100);
      const fitCamera = () => {
        const t = Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2);
        const half = 2.35;
        camera.aspect = W / H;
        camera.position.set(0, 0, Math.max(half / t, half / (t * camera.aspect)));
        camera.lookAt(0, 0, 0);
        camera.updateProjectionMatrix();
        camera.updateMatrixWorld(true);
      };
      fitCamera();

      /* ---------- Cahaya ---------- */
      const pmrem = new THREE.PMREMGenerator(renderer);
      const envTarget = pmrem.fromScene(new RoomEnvironment(), 0.04);
      scene.environment = envTarget.texture;
      Object.assign(scene, { environmentIntensity: 0.8 });
      scene.add(new THREE.AmbientLight(0xffffff, 0.3));
      const key = new THREE.DirectionalLight(0x8ba8ff, 2.2); key.position.set(2, 3, 4); scene.add(key);
      const rim = new THREE.DirectionalLight(0xb79cff, 3); rim.position.set(-3, 1.5, -3); scene.add(rim);
      const fill = new THREE.DirectionalLight(0xffffff, 0.8); fill.position.set(0, 1, 5); scene.add(fill);

      /* ---------- Material ---------- */
      const shell = new THREE.MeshPhysicalMaterial({ color: 0xe8edf8, metalness: 0.3, roughness: 0.3, clearcoat: 1, clearcoatRoughness: 0.15 });
      const dark = new THREE.MeshPhysicalMaterial({ color: 0x0a0c13, metalness: 0.7, roughness: 0.18, clearcoat: 1, clearcoatRoughness: 0.1 });
      const glow = (i: number) => new THREE.MeshStandardMaterial({ color: 0x0b1226, emissive: 0x8ba8ff, emissiveIntensity: i, roughness: 0.4 });
      const eyeMat = glow(0), coreMat = glow(1.5), trimMat = glow(1.2), tipMat = glow(1.5);

      // Tekstur halo lembut untuk efek bloom palsu
      const dc = document.createElement('canvas'); dc.width = dc.height = 64;
      const dctx = dc.getContext('2d')!;
      const g = dctx.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.35, 'rgba(160,185,255,0.45)'); g.addColorStop(1, 'rgba(139,168,255,0)');
      dctx.fillStyle = g; dctx.fillRect(0, 0, 64, 64);
      const haloTex = new THREE.CanvasTexture(dc);
      haloTex.colorSpace = THREE.SRGBColorSpace;
      const halo = (scale: number) => {
        const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: haloTex, color: 0x8ba8ff, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending }));
        s.scale.setScalar(scale);
        return s;
      };

      /* ---------- Robot dari primitif ---------- */
      const rig = new THREE.Group();
      const body = new THREE.Group();
      const head = new THREE.Group();
      rig.add(body, head);
      scene.add(rig);
      rig.position.y = 0.7;

      // Kepala
      head.add(new THREE.Mesh(new RoundedBoxGeometry(1.75, 1.4, 1.4, 6, 0.42), shell));
      const visor = new THREE.Mesh(new RoundedBoxGeometry(1.42, 0.82, 0.16, 5, 0.28), dark);
      visor.position.set(0, 0, 0.66);
      head.add(visor);

      // Mata + halo
      const eyes = new THREE.Group();
      eyes.position.set(0, 0.04, 0.75);
      const eyeGeo = new THREE.CapsuleGeometry(0.075, 0.18, 6, 16);
      const eyeL = new THREE.Mesh(eyeGeo, eyeMat), eyeR = new THREE.Mesh(eyeGeo, eyeMat);
      eyeL.position.x = -0.32; eyeR.position.x = 0.32;
      const haloL = halo(0.8), haloR = halo(0.8);
      haloL.position.set(-0.32, 0, 0.05); haloR.position.set(0.32, 0, 0.05);
      eyes.add(eyeL, eyeR, haloL, haloR);
      head.add(eyes);

      // LED status di bawah mata
      const leds: InstanceType<Three['Mesh']>[] = [];
      for (let i = 0; i < 5; i++) {
        const m = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.022, 0.01), glow(0.4));
        m.position.set((i - 2) * 0.11, -0.25, 0.745);
        head.add(m); leds.push(m);
      }

      // Telinga + cincin aksen
      for (const sx of [-1, 1]) {
        const ear = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 0.22, 32), shell);
        ear.rotation.z = Math.PI / 2; ear.position.x = sx * 0.94;
        const ring = new THREE.Mesh(new THREE.TorusGeometry(0.16, 0.018, 10, 40), trimMat);
        ring.rotation.y = Math.PI / 2; ring.position.x = sx * 1.06;
        head.add(ear, ring);
      }

      // Antena
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.3, 12), dark);
      stem.position.y = 0.85;
      const tip = new THREE.Mesh(new THREE.SphereGeometry(0.075, 20, 20), tipMat);
      tip.position.y = 1.04;
      const tipHalo = halo(0.55); tipHalo.position.y = 1.04;
      head.add(stem, tip, tipHalo);

      // Badan
      const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.36, 0.32, 28), dark);
      neck.position.y = -0.82;
      const torso = new THREE.Mesh(new RoundedBoxGeometry(2.3, 1.5, 1.25, 6, 0.5), shell);
      torso.position.y = -1.73;
      const core = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.06, 32), coreMat);
      core.rotation.x = Math.PI / 2; core.position.set(0, -1.6, 0.64);
      const coreRing = new THREE.Mesh(new THREE.TorusGeometry(0.29, 0.02, 10, 48), trimMat);
      coreRing.position.set(0, -1.6, 0.64);
      const coreHalo = halo(1.1); coreHalo.position.set(0, -1.6, 0.75);
      body.add(neck, torso, core, coreRing, coreHalo);
      for (const sx of [-1, 1]) {
        const shoulder = new THREE.Mesh(new THREE.SphereGeometry(0.42, 28, 28), shell);
        shoulder.position.set(sx * 1.4, -1.3, 0);
        const arm = new THREE.Mesh(new THREE.CapsuleGeometry(0.23, 0.55, 8, 20), shell);
        arm.position.set(sx * 1.62, -1.95, 0); arm.rotation.z = -sx * 0.12;
        body.add(shoulder, arm);
      }

      /* ---------- State ---------- */
      const clock = new THREE.Clock();
      const s = {
        mx: 0, my: 0, inside: false, hasPointer: false, lastMove: -99,
        fx: W / 2, fy: H * 0.4, r: 0, px: 0, py: 0,
        yaw: 0, pitch: 0, mode: 0,
        blinkAt: 2.5, blinkT: -1,
      };
      const scan = { active: false, p: 0 };
      let intro = reduced ? 1 : 0;
      let ready = false;
      let scanTimer = 0;
      const tmp = new THREE.Vector3();

      const startScan = () => { if (reduced || scan.active) return; scan.active = true; scan.p = 0; };

      /* ---------- Input ---------- */
      const onMove = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse') return;
        const r = stageEl.getBoundingClientRect();
        s.mx = e.clientX - r.left; s.my = e.clientY - r.top;
        s.inside = s.mx >= 0 && s.mx <= r.width && s.my >= 0 && s.my <= r.height;
        s.hasPointer = true; s.lastMove = clock.elapsedTime;
        if (s.inside) scan.active = false;
      };
      const onOut = (e: MouseEvent) => { if (!e.relatedTarget) s.inside = false; };
      const onDown = () => startScan();

      if (!reduced) {
        window.addEventListener('pointermove', onMove, { passive: true });
        document.addEventListener('mouseout', onOut);
        stageEl.addEventListener('pointerdown', onDown);
      }

      /* ---------- Loop ---------- */
      const renderOnce = () => renderer.render(scene, camera);
      let reqId: number | null = null;
      let visible = true;
      let frameNo = 0;

      const frame = () => {
        reqId = requestAnimationFrame(frame);
        const dt = Math.min(clock.getDelta(), 0.1);
        const t = clock.elapsedTime;

        /* Intro: robot "menyala" */
        if (ready && intro < 1) intro = Math.min(1, intro + dt / 1.8);
        rig.scale.setScalar(ready ? 0.72 + 0.28 * easeOutBack(clamp(intro * 1.4, 0, 1)) : 0.0001);
        rig.position.y = 0.7 - (1 - easeOutExpo(intro)) * 0.6 + Math.sin(t * 1.4) * 0.03;

        /* Posisi kepala di layar (acuan arah pandang & jarak kursor) */
        head.getWorldPosition(tmp);
        tmp.project(camera);
        const hx = (tmp.x * 0.5 + 0.5) * W;
        const hy = (-tmp.y * 0.5 + 0.5) * H;

        /* Target pengungkapan wajah */
        let tx = s.fx, ty = s.fy, targetR = 0;
        const pointerFresh = s.hasPointer && t - s.lastMove < 4;
        let lookX: number, lookY: number;

        if (scan.active) {
          scan.p = Math.min(1, scan.p + dt / 3.4);
          const e = easeInOut(scan.p);
          tx = W * (0.12 + 0.76 * e);
          ty = H * (0.36 + 0.1 * Math.sin(scan.p * TAU));
          targetR = 0.12 + 0.88 * Math.sin(Math.PI * scan.p);
          lookX = tx; lookY = ty;
          if (scan.p >= 1) scan.active = false;
        } else if (s.inside) {
          const dist = Math.hypot(s.mx - hx, s.my - hy);
          const prox = 1 - clamp(dist / (Math.min(W, H) * 0.55), 0, 1);
          tx = s.mx; ty = s.my;
          targetR = 0.3 + 0.7 * prox;
          lookX = s.mx; lookY = s.my;
        } else if (pointerFresh) {
          lookX = s.mx; lookY = s.my;
        } else {
          lookX = hx + Math.sin(t * 0.5) * W * 0.18;
          lookY = hy + Math.sin(t * 0.37) * H * 0.04;
        }

        const follow = scan.active ? 0.2 : 0.12;
        s.fx += (tx - s.fx) * follow;
        s.fy += (ty - s.fy) * follow;
        s.r += (targetR - s.r) * (targetR > s.r ? 0.06 : 0.03);

        const m = Math.min(W, H);
        const px = s.inside ? -(s.mx / W - 0.5) * 18 : 0;
        const py = s.inside ? -(s.my / H - 0.5) * 18 : 0;
        s.px += (px - s.px) * 0.08; s.py += (py - s.py) * 0.08;
        setFace(s.fx, s.fy, m * (0.22 + 0.3 * s.r), Math.max(0.1, s.r), 0.1, s.px, s.py);

        /* Kepala & badan mengikuti arah pandang */
        const dx = (lookX - hx) / (W * 0.5);
        const dy = (lookY - hy) / (H * 0.5);
        s.yaw += (clamp(dx * 0.9, -0.7, 0.7) - s.yaw) * 0.08;
        s.pitch += (clamp(dy * 0.6, -0.4, 0.4) - s.pitch) * 0.08;
        head.rotation.set(s.pitch, s.yaw, 0);
        body.rotation.y = s.yaw * 0.25;
        torso.scale.y = 1 + Math.sin(t * 1.4) * 0.008;
        eyes.position.x += (clamp(dx, -1, 1) * 0.07 - eyes.position.x) * 0.15;
        eyes.position.y += (0.04 - clamp(dy, -1, 1) * 0.04 - eyes.position.y) * 0.15;

        /* Kedipan */
        let blink = 1;
        if (t > s.blinkAt && s.blinkT < 0) s.blinkT = 0;
        if (s.blinkT >= 0) {
          s.blinkT += dt / 0.16;
          blink = 1 - Math.sin(Math.min(s.blinkT, 1) * Math.PI);
          if (s.blinkT >= 1) { s.blinkT = -1; s.blinkAt = t + 2.5 + Math.random() * 3; }
        }
        eyeL.scale.y = eyeR.scale.y = Math.max(0.08, blink);

        /* Cahaya bereaksi pada pengungkapan wajah */
        const on = clamp((intro - 0.35) / 0.25, 0, 1);
        const flicker = intro < 0.65 ? (Math.sin(t * 70) > 0 ? 1 : 0.25) : 1;
        const eyeI = (1.1 + 2.4 * s.r) * on * flicker;
        eyeMat.emissiveIntensity = eyeI;
        haloL.material.opacity = haloR.material.opacity = (0.25 + 0.55 * s.r) * on * flicker * blink;
        coreMat.emissiveIntensity = (1.2 + 1.6 * s.r + Math.sin(t * 2.2) * 0.25) * on;
        coreHalo.material.opacity = (0.25 + 0.4 * s.r) * on;
        trimMat.emissiveIntensity = (0.9 + 1.0 * s.r) * on;
        const pulse = 0.5 + 0.5 * Math.sin(t * 3);
        tipMat.emissiveIntensity = (1.2 + 1.6 * pulse) * on;
        tipHalo.material.opacity = (0.2 + 0.4 * pulse) * on;
        leds.forEach((l, i) => {
          (l.material as InstanceType<Three['MeshStandardMaterial']>).emissiveIntensity =
            (0.3 + 1.6 * Math.max(0, Math.sin(t * 4 - i * 0.7))) * on * (0.5 + 0.5 * s.r);
        });

        /* HUD */
        if (++frameNo % 6 === 0) {
          const mode = s.r > 0.62 ? 2 : s.r > 0.18 ? 1 : 0;
          if (mode !== s.mode) {
            s.mode = mode;
            this.dataset.mode = String(mode);
            statusEl.textContent = ['Standby', 'Scanning…', 'Identity verified'][mode];
          }
        }

        renderer.render(scene, camera);
      };

      const start = () => { if (reduced) return; if (reqId === null) { clock.getDelta(); frame(); } };
      const stop = () => { if (reqId !== null) { cancelAnimationFrame(reqId); reqId = null; } };

      const markReady = () => {
        ready = true;
        this.dataset.state = 'ready';
        progressEl.textContent = '100%';
        if (reduced) {
          // Reduced motion: robot menyala statis, wajah terlihat tanpa animasi
          [eyeMat, coreMat, trimMat, tipMat].forEach((mm) => (mm.emissiveIntensity = 1.8));
          [haloL, haloR, coreHalo, tipHalo].forEach((sp) => (sp.material.opacity = 0.5));
          staticFace();
          statusEl.textContent = 'Identity verified';
          renderOnce();
        } else {
          start();
          scanTimer = window.setTimeout(startScan, 1400); // satu sapuan pembuka sebagai petunjuk interaksi
        }
      };
      markReady();

      const io = new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible && !document.hidden) start(); else stop();
      });
      io.observe(stageEl);

      const onVisibility = () => { if (document.hidden) stop(); else if (visible) start(); };
      document.addEventListener('visibilitychange', onVisibility);

      const ro = new ResizeObserver((entries) => {
        const { width, height } = entries[0].contentRect;
        if (!width || !height) return;
        W = width; H = height;
        renderer.setSize(W, H, false);
        fitCamera();
        if (reqId === null && ready) renderOnce();
      });
      ro.observe(stageEl);

      const onContextLost = (e: Event) => { e.preventDefault(); stop(); fail(); };
      canvas.addEventListener('webglcontextlost', onContextLost);

      this.cleanup = () => {
        stop();
        clearTimeout(scanTimer);
        io.disconnect();
        ro.disconnect();
        window.removeEventListener('pointermove', onMove);
        document.removeEventListener('mouseout', onOut);
        document.removeEventListener('visibilitychange', onVisibility);
        stageEl.removeEventListener('pointerdown', onDown);
        canvas.removeEventListener('webglcontextlost', onContextLost);
        scene.traverse((obj: any) => {
          obj.geometry?.dispose?.();
          const mats = Array.isArray(obj.material) ? obj.material : obj.material ? [obj.material] : [];
          mats.forEach((mm: any) => { mm.map?.dispose?.(); mm.dispose?.(); });
        });
        haloTex.dispose();
        envTarget.dispose();
        pmrem.dispose();
        renderer.dispose();
        renderer.forceContextLoss();
      };
    }
  }

  if (!customElements.get('robot-hero')) {
    customElements.define('robot-hero', RobotHero);
  }
</script>
